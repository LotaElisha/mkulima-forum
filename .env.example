APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_TOKEN_EXPIRATION=480

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# External integrations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CREDENTIALS_PATH=storage/app/private/google-drive-service-account.json
# Comma-separated web, Android server, and iOS OAuth client IDs accepted by the backend.
GOOGLE_AUTH_CLIENT_IDS=
# Comma-separated Apple bundle ID and Services ID accepted by the backend.
APPLE_AUTH_CLIENT_IDS=
ANDROID_APP_PACKAGE=app.mkulimaforum.mobile
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_FROM=MKULIMA
SMS_GATEWAY=africastalking
SMS_SENDER_ID=MKULIMA
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_ENV=sandbox
# Generate a long random value. The callback URL includes it and callbacks are rejected without it.
MPESA_CALLBACK_SECRET=
RUN_PAYMENT_SANDBOX=false
MPESA_SANDBOX_PHONE=254708374149
TIGOPESA_SANDBOX_PHONE=255713000000
ADMIN_EMAIL=admin@mkulimaforum.com
ADMIN_PASSWORD=

# ── Email authentication (required for launch) ───────────────────────────────
# Password reset and email verification both send mail. With MAIL_MAILER unset
# or MAIL_PASSWORD empty, registration silently produces accounts that can
# never recover a lost password.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="MkulimaForum"

# Verification links and reset links are built from APP_URL. If this is wrong
# in production, every emailed link points at the wrong host.
# APP_URL=https://mkulimaforum.com

# ── SMS / OTP delivery ───────────────────────────────────────────────────────
# Selects an App\Contracts\SmsProvider implementation:
#   africastalking | twilio | log
# 'log' writes messages to the application log instead of sending them.
SMS_PROVIDER=africastalking
SMS_SENDER_ID=MKULIMA
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ── Webhook shared secrets (required in production) ──────────────────────────
# Gateway callbacks carry no user credential. Without these, /api/sms/* and
# /api/ivr/* are open endpoints; in production they refuse all traffic until
# a secret is set. Present the value as X-Webhook-Signature.
SMS_WEBHOOK_SECRET=
IVR_WEBHOOK_SECRET=

# ── Session / token lifetime ─────────────────────────────────────────────────
# Minutes. The API reports this to the mobile app as expires_in, so the two
# can no longer disagree.
SANCTUM_TOKEN_EXPIRATION=43200

# ── First administrator (seeding only) ───────────────────────────────────────
# AdminUserSeeder refuses to run without these; there is no default password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
