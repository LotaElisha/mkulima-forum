{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "admin-dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "admin-dashboard"
      ],
      "port": 3020
    },
    {
      "name": "flutter-web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port",
        "5051",
        "--dart-define=API_URL=http://localhost:8010/api"
      ],
      "cwd": "mkulima_app",
      "port": 5051
    },
    {
      "name": "landing",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DB_CONNECTION=pgsql",
        "DB_HOST=127.0.0.1",
        "DB_PORT=5432",
        "DB_DATABASE=mkulima_dev",
        "DB_USERNAME=mkulima",
        "DB_PASSWORD=secret",
        "php",
        "artisan",
        "serve",
        "--port=8001",
        "--no-reload"
      ],
      "port": 8001
    },
    {
      "name": "api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DB_CONNECTION=pgsql",
        "DB_HOST=127.0.0.1",
        "DB_PORT=5432",
        "DB_DATABASE=mkulima_dev",
        "DB_USERNAME=mkulima",
        "DB_PASSWORD=secret",
        "php",
        "artisan",
        "serve",
        "--port=8010",
        "--no-reload"
      ],
      "port": 8010
    }
  ]
}
