# /etc/cron.d/mkulima-forum
# Install with: sudo cp deploy/cron/mkulima-forum /etc/cron.d/mkulima-forum
# Times are UTC. The queue worker is supervised; cron only starts the scheduler
# and the jobs that are not inside the Laravel scheduler.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Laravel scheduler. Required every minute.
* * * * * www-data cd /opt/data/projects/mkulima-forum && /usr/bin/php artisan schedule:run >> /var/log/mkulima-schedule.log 2>&1

# Postgres backup, then a restore into a side database that is dropped afterwards.
0 4 * * * root ENV_FILE=/opt/data/projects/mkulima-forum/.env BACKUP_DIR=/opt/backups/mkulima-forum /opt/data/projects/mkulima-forum/scripts/backup-mkulima-db.sh >> /var/log/mkulima-db-backup.log 2>&1
30 4 * * * root ENV_FILE=/opt/data/projects/mkulima-forum/.env BACKUP_DIR=/opt/backups/mkulima-forum /opt/data/projects/mkulima-forum/scripts/verify-postgres-backup.sh >> /var/log/mkulima-db-restore-check.log 2>&1

# Existing operational jobs. Logs are what scripts/mkulima-cron-monitor.sh reads.
0 6 * * * www-data cd /opt/data/projects/mkulima-forum && /usr/bin/php artisan market-prices:sync --country=Tanzania >> /var/log/mkulima-market-prices-sync.log 2>&1
0 7 * * * www-data cd /opt/data/projects/mkulima-forum && /usr/bin/php artisan weather:cache >> /var/log/mkulima-weather-cache.log 2>&1
0 8 * * * root /usr/local/bin/ssl-monitor-mkulima.sh >> /var/log/mkulima-ssl-monitor.log 2>&1
0 9 * * * root /usr/local/bin/mkulima-cron-monitor.sh >> /var/log/mkulima-cron-monitor.log 2>&1
*/5 * * * * root /usr/local/bin/mkulima-uptime-monitor.sh >> /var/log/mkulima-uptime.log 2>&1
